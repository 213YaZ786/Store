<?xml version="1.0" encoding="utf-8"?>
<!-- Store's launcher glyph: a glossy disc with an ivory storefront in relief.
     The disc's grey body is multiplied by a tone of the wallpaper's accent,
     its white rim lights it, untinted, and the storefront lies on top as drawn. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <bitmap
            android:src="@drawable/store_body"
            android:tint="@color/ic_launcher_disc"
            android:tintMode="multiply" />
    </item>
    <item android:drawable="@drawable/store_shine" />
    <item android:drawable="@drawable/store_front" />
</layer-list>
